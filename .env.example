# Copy to .env and edit. All values have safe defaults, so .env is optional.
RAW_DIR=data/raw
CLEAN_DIR=data/clean
REJECTED_DIR=data/rejected
LOG_DIR=logs
# parquet (default in Docker) or csv
OUTPUT_FORMAT=parquet
# Fixed "as of" date so results never depend on today's date (keeps runs repeatable)
DATA_CUTOFF_DATE=2026-09-30
# Fail the run if more than this % of any table is rejected
MAX_REJECT_PCT=2.0
